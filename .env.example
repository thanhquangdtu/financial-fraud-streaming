# Copy to .env (gitignored) and adjust. Defaults shown.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions.raw
# Replay rate in events per second (must be > 0)
REPLAY_RATE=10
# Development input = validation split; use data/processed/test.csv only for demo / final evaluation
REPLAY_INPUT=data/processed/validation.csv

